<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar" />

    <!-- Post-launch theme (the app theme after the splash screen) -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- Background color for the splash screen -->
        <item name="windowSplashScreenBackground">#1976D2</item>
        <!-- Icon to be shown on the splash screen -->
        <item name="windowSplashScreenAnimatedIcon">@mipmap/instant_weather_new</item>
        <!-- Duration to show the splash screen (only for API 31+) -->
        <item name="windowSplashScreenAnimationDuration">200</item>
        <!-- Theme to use after the splash screen -->
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>
</resources>
